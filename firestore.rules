rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function isAdmin() {
      return isSignedIn() && (getUserData().role == 'admin' || request.auth.token.role == 'admin');
    }
    
    function isDriver() {
      return isSignedIn() && (getUserData().role == 'driver' || request.auth.token.role == 'driver');
    }

    // User profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId && !('role' in request.resource.data && request.resource.data.role == 'admin');
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
      allow delete: if isAdmin();
    }

    // Public transit entities (buses, routes, stops, schedules, active alerts)
    match /buses/{busId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /routes/{routeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /stops/{stopId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /schedules/{scheduleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /alerts/{alertId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Trips - Drivers can update their assigned trip, Admins full access
    match /trips/{tripId} {
      allow read: if true;
      allow create: if isDriver() || isAdmin();
      allow update: if isAdmin() || (isDriver() && resource.data.driverId == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Bus Locations - Real-time position updates
    match /locations/{busId} {
      allow read: if true;
      allow write: if isAdmin() || isDriver();
    }

    // Favorites - User private collection
    match /favorites/{userId}/items/{favoriteId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
